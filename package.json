{
  "name": "@romaandev/corebase-js",
  "version": "1.0.0",
  "description": "Official JS/React Native client for Corebase",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build",
    "prepare": "bun run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Roman Tufail <mroman7>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mroman7/corebase-js.git"
  },
  "bugs": {
    "url": "https://github.com/mroman7/corebase-js/issues"
  },
  "homepage": "https://github.com/mroman7/corebase-js#readme",
  "keywords": [
    "corebase",
    "baas",
    "backend-as-a-service",
    "javascript",
    "react-native",
    "sdk",
    "client"
  ],
  "dependencies": {
    "axios": "^1.20.0",
    "better-auth": "^1.7.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3"
  }
}